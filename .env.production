# Public build-time settings for production builds (Cloudflare included).
# Committed on purpose: every VITE_ value is compiled into the JavaScript the
# browser downloads, so nothing secret may ever go in this file.

# Google Sign-In OAuth 2.0 Web client id. Public: Google's button sends it from
# the browser. Must match the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=632441370393-mclipm8f4graaq5cj7kq2r6q7vrj9l12.apps.googleusercontent.com
